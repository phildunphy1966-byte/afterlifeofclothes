{
  "project": {
    "name": "The Afterlife of Clothes",
    "slug": "afterlife-of-clothes",
    "type": "interactive-data-storytelling-web-experience",
    "audience": "Urban Indian young adults, approximately 18–30",
    "keyMessage": "Discarding a garment ends your relationship with it — not necessarily its life.",
