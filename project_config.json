        "stateKey": "disposalChoice"
      },
      {
        "id": "collection",
        "title": "Your T-shirt leaves home",
        "interaction": "interactive_sankey"
      },
      {
        "id": "sorting",
        "title": "Clothes don't sort themselves",
        "interaction": "sorting_activity"
      },
      {
        "id": "panipat",
        "title": "From old textile to new material",
        "interaction": "interactive_map_process"
      },
      {
        "id": "definitions",
        "title": "A second life can mean different things",
        "interaction": "expandable_cards"
      },
      {
        "id": "outcomes",
        "title": "Where does post-consumer textile waste end up?",
        "interaction": "pictogram_toggle"
      },
      {
        "id": "comparison",
        "title": "Something changes after we buy it",
        "interaction": "pre_post_comparison"
      },
      {
        "id": "survey",
        "title": "What do young consumers think happens next?",
        "interaction": "interactive_charts",
        "status": "TBD until real survey data is supplied"
      },
      {
        "id": "voices",
        "title": "What people told us",
        "interaction": "filterable_quote_wall",
        "status": "TBD until real survey responses are supplied"
      },
      {
        "id": "recap",
        "title": "Remember your T-shirt?",
        "interaction": "personalised_recap"
      },
      {
        "id": "reflection",
        "title": "You were done with it. But its story continued.",
        "interaction": "reflection"
      }
    ]
  },
